# Environment variables example for MarkMosaiq SaaS & Whop Commerce (Merchant of Record)

# OpenAI API Key (pour la génération d'images et Vision QA)
OPEN_AI_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Auth, Workspaces, Invoices, Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL pour redirections checkout & webhooks
NEXT_PUBLIC_APP_URL=https://app.MarkMosaiq.tn

# Whop Commerce Configuration (https://docs.whop.com)
WHOP_API_KEY=apik_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WHOP_APP_ID=app_xxxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# Store & Plans Whop
NEXT_PUBLIC_WHOP_STORE_URL=https://whop.com/MarkMosaiq
WHOP_PLAN_FLASH=plan_flash_MarkMosaiq_starter
WHOP_PLAN_PRO=plan_pro_MarkMosaiq_launch
WHOP_PLAN_AGENCY=plan_agency_MarkMosaiq_b2b

# Direct Checkout Links (Optionnel)
NEXT_PUBLIC_WHOP_CHECKOUT_FLASH=https://whop.com/checkout/plan_flash_MarkMosaiq_starter
NEXT_PUBLIC_WHOP_CHECKOUT_PRO=https://whop.com/checkout/plan_pro_MarkMosaiq_launch
NEXT_PUBLIC_WHOP_CHECKOUT_AGENCY=https://whop.com/checkout/plan_agency_MarkMosaiq_b2b

# Namecheap Private Email (SMTP Configuration)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@yourdomain.com
SMTP_PASSWORD=your_namecheap_private_email_password
SMTP_FROM="MarkMosaiq <contact@yourdomain.com>"

