# Environment variables example for Adora SaaS & Paddle Billing

# OpenAI API Key (pour la génération d'images et Vision QA)
OPEN_AI_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Auth, Workspaces, Invoices, Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paddle Billing Configuration
# NEXT_PUBLIC_PADDLE_ENV doit être 'sandbox' ou 'production' (échoue explicitement si manquant)
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Token Client-Side Paddle.js (commence par test_ en sandbox ou live_ en production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète Webhook Paddle (Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_xxxxxxxxxxxxxxxxxxxx

# Clé API Paddle Serveur (uniquement côté serveur, jamais exposé au client)
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxx

# Price IDs pour les forfaits Starter, Pro, Advanced (mensuel et annuel)
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=pri_01xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=pri_01xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_01xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_01xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=pri_01xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=pri_01xxxxxxxxxxxxxxxxxxxx
